#!/bin/sh
# Runs the same checks as the "Commit Quality" CI workflow (PHP-CS-Fixer, PHPStan)
# against src/ before allowing a commit. PHP-CS-Fixer issues are fixed
# automatically and re-staged; PHPStan issues block the commit since they
# can't be auto-fixed. Enabled via `composer install` (see composer.json's
# post-install-cmd), or manually with:
#   git config core.hooksPath .githooks

set -e

REPO_ROOT=$(git rev-parse --show-toplevel)
cd "$REPO_ROOT"

STAGED_SRC_FILES=$(git diff --cached --name-only --diff-filter=ACM -- 'src/*.php' 'src/*.page' 'src/*.inc')

if [ -z "$STAGED_SRC_FILES" ]; then
    exit 0
fi

if [ ! -x vendor/bin/php-cs-fixer ] || [ ! -x vendor/bin/phpstan ]; then
    echo "pre-commit: vendor/bin/php-cs-fixer or vendor/bin/phpstan not found; run 'composer install' first." >&2
    exit 1
fi

echo "pre-commit: running PHP-CS-Fixer on staged src/ files..."
vendor/bin/php-cs-fixer fix --diff --path-mode=intersection -- $STAGED_SRC_FILES
git add -- $STAGED_SRC_FILES

echo "pre-commit: running PHPStan on src/..."
if ! vendor/bin/phpstan analyse; then
    echo "pre-commit: PHPStan found issues." >&2
    exit 1
fi

exit 0
