parameters:
  level: 9
  fileExtensions:
    - php
    - page
  paths:
    - src
  scanFiles:
    # Page files require this via its absolute Unraid path, which PHPStan can't resolve
    - src/usr/local/emhttp/plugins/app-update-helper/include/common.php
  typeAliases:
    Job: 'array{id: string, container: string, mode: string, archive: string, status: string, created: int, started: int, finished: int, message: string}'
  excludePaths:
    - */vendor/*
  ignoreErrors:
    - # Ignore filesystem paths that won't be present in the dev environment
      messages:
        - "#/usr/local/emhttp/plugins/.*.php#"
      identifier: requireOnce.fileNotFound
    - # Ignore missing dynamix helper functions that won't be present in the dev environment
      messages:
        - "#autov#"
        - "#parse_plugin_cfg#"
        - "#xmlToCommand#"
      identifier: function.notFound
    - # Ignore Unraid's DockerClient/DockerUtil classes, which are only available in a live Unraid environment
      messages:
        - "#DockerClient#"
        - "#DockerUtil#"
      identifier: class.notFound
  reportUnmatchedIgnoredErrors: false