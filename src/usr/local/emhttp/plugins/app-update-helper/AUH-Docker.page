Menu="Docker"
Title="App Update Helper"
---
<?php
require_once '/usr/local/emhttp/plugins/app-update-helper/include/common.php';

$auhBackupReady = auhBackupDestinationValid(auhLoadConfig());
?>
<style>
    .version-table { width: 100%; border-collapse: collapse; }
    .version-table th, .version-table td { padding: 10px; text-align: left; border-bottom: 1px solid #333; }
    .status-major { color: #ff4c4c; font-weight: bold; }
    .status-minor { color: #ffb84d; font-weight: bold; }
    .status-patch { color: #4caf50; font-weight: bold; }
    .status-build { color: #00bcd4; }
    .has-tooltip { position: relative; cursor: help; }
    .has-tooltip::after {
        content: attr(data-tooltip);
        display: none;
        position: absolute;
        left: 0;
        bottom: 100%;
        margin-bottom: 6px;
        background: #222;
        color: #fff;
        padding: 4px 8px;
        border-radius: 4px;
        font-size: 12px;
        font-weight: normal;
        white-space: pre-line;
        z-index: 10;
    }
    .has-tooltip:hover::after,
    .has-tooltip.tooltip-active::after {
        display: block;
    }
    .plugin-spinner { display: inline-block; width: 16px; height: 16px; border: 2px solid #ccc; border-radius: 50%; border-top-color: #333; animation: spin 1s linear infinite; vertical-align: middle; }
    @keyframes spin { to { transform: rotate(360deg); } }
    .auh-actions { white-space: nowrap; }
    .auh-actions button { margin: 0 4px 0 0; padding: 4px 10px; min-width: 0; }
    .auh-job { display: inline-block; margin-left: 4px; }
    .auh-job-done { color: #4caf50; }
    .auh-job-failed { color: #ff4c4c; }
    .auh-modal-overlay { display: none; position: fixed; inset: 0; background: rgba(0, 0, 0, 0.6); z-index: 1000; }
    .auh-modal { position: absolute; top: 10%; left: 50%; transform: translateX(-50%); width: min(900px, 90vw); background: #1c1c1c; color: #eee; border-radius: 6px; padding: 16px; box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5); }
    .auh-modal h3 { margin: 0 0 10px 0; font-size: 16px; }
    .auh-modal pre { height: 50vh; overflow: auto; background: #000; color: #ddd; padding: 10px; margin: 0 0 10px 0; font-size: 12px; white-space: pre-wrap; word-break: break-word; }
    .auh-modal .auh-modal-footer { text-align: right; }
    .auh-modal .auh-modal-hint { margin-right: 1em; opacity: 0.7; }
</style>

<div class="title">
    <span class="left">Docker Application Versions</span>
</div>

<table class="version-table" id="app-versions-table">
    <thead>
        <tr>
            <th>Container Name</th>
            <th>Current Version</th>
            <th>Newest Version</th>
            <th class="has-tooltip" data-tooltip="Major: breaking or major release&#10;Minor: new features, backwards compatible&#10;Patch: bug fixes only&#10;Build: same version, new build/tag&#10;Update Available: an update exists but versions couldn't be compared">Update Type</th>
            <th>Released</th>
            <th>Release Notes</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody id="app-versions-body">
        <tr>
            <td colspan="7" style="text-align:center;"><div class="plugin-spinner"></div> Fetching versions... this may take a moment.</td>
        </tr>
    </tbody>
</table>

<div class="auh-modal-overlay" id="auh-log-overlay">
    <div class="auh-modal">
        <h3 id="auh-log-title"></h3>
        <pre id="auh-log-content"></pre>
        <div class="auh-modal-footer">
            <span class="auh-modal-hint" id="auh-log-hint">Closing this window does not stop the job; it keeps running in the background. Reopen this log any time with "View log" in the Actions column.</span>
            <input type="button" id="auh-log-close" value="Close">
        </div>
    </div>
</div>

<script>
const AUH_JOBS_URL = "/plugins/app-update-helper/jobs.php";
const AUH_CSRF_TOKEN = <?= json_encode(auhCsrfToken()); ?>;
const AUH_BACKUP_READY = <?= $auhBackupReady ? 'true' : 'false'; ?>;

let auhApps = {};          // container name -> row data from api.php
let auhJobs = [];          // job list from jobs.php, oldest first
let auhFinishedIds = null; // ids of finished jobs seen in the previous poll
let auhPollTimer = null;
let auhPollXhr = null;     // in-flight status request; only one may run at a time
const AUH_DONE_VISIBLE_SECONDS = 3600;
let auhLogJob = null;    // job whose log is shown in the modal
let auhLogOffset = 0;

function escapeHtml(value) {
    return String(value ?? '').replace(/[&<>"']/g, c => ({'&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'}[c]));
}

function getVersionTooltip(current, newest, type) {
    if (!type || current === "Unknown" || newest === "Unknown") return "";

    let cParts = current.split('-');
    let rParts = newest.split('-');
    let cBase = cParts[0].split('.');
    let rBase = rParts[0].split('.');

    let cMajor = cBase[0] || 'x';
    let rMajor = rBase[0] || 'x';
    let cMinor = cBase[1] || 'x';
    let rMinor = rBase[1] || 'x';
    let cPatch = cBase[2] || 'x';
    let rPatch = rBase[2] || 'x';

    let cSuffix = cParts[1] ? '-' + cParts[1] : '';
    let rSuffix = rParts[1] ? '-' + rParts[1] : '';

    if (type === 'Major') {
        return `${cMajor}.x.x -> ${rMajor}.x.x`;
    } else if (type === 'Minor') {
        return `x.${cMinor}.x -> x.${rMinor}.x`;
    } else if (type === 'Patch') {
        return `x.x.${cPatch} -> x.x.${rPatch}`;
    } else if (type === 'Build') {
        return `x.x.x${cSuffix} -> x.x.x${rSuffix}`;
    }
    return `${current} -> ${newest}`;
}

function formatVersionDisplay(version, type) {
    if (!type || version === "Unknown") return version;

    if (type === 'Update Available') {
        return `<u>${version}</u>`;
    }

    let parts = version.split('-');
    let baseParts = parts[0].split('.');
    let suffix = parts.length > 1 ? parts.slice(1).join('-') : null;

    if (type === 'Major' && baseParts[0] !== undefined) {
        baseParts[0] = `<u>${baseParts[0]}</u>`;
    } else if (type === 'Minor' && baseParts[1] !== undefined) {
        baseParts[1] = `<u>${baseParts[1]}</u>`;
    } else if (type === 'Patch' && baseParts[2] !== undefined) {
        baseParts[2] = `<u>${baseParts[2]}</u>`;
    } else if (type === 'Build' && suffix !== null) {
        suffix = `<u>${suffix}</u>`;
    }

    let result = baseParts.join('.');
    if (suffix !== null) {
        result += '-' + suffix;
    }
    return result;
}

function isJobActive(job) {
    return job.status === 'queued' || job.status === 'running';
}

function latestJobFor(name) {
    for (let i = auhJobs.length - 1; i >= 0; i--) {
        if (auhJobs[i].container === name) return auhJobs[i];
    }
    return null;
}

function jobLabel(job) {
    if (job.mode === 'restore') return 'Restore';
    return job.mode === 'backup_update' ? 'Backup & update' : 'Update';
}

function actionButton(name, mode, text, disabledReason) {
    let button = `<button type="button" class="auh-action" data-container="${escapeHtml(name)}" data-mode="${mode}"${disabledReason ? ' disabled' : ''}>${text}</button>`;
    return disabledReason ? `<span class="has-tooltip" data-tooltip="${escapeHtml(disabledReason)}">${button}</span>` : button;
}

function renderActions(name) {
    let app = auhApps[name];
    let job = latestJobFor(name);
    let active = job && isJobActive(job);
    let html = "";

    if (app && app.update_type) {
        let notManaged = app.managed ? "" : "Not managed by Unraid Docker templates";
        let busy = active ? "A job for this container is already queued or running" : "";
        html += actionButton(name, 'update', 'Update', notManaged || busy);
        html += actionButton(name, 'backup_update', 'Backup &amp; Update',
            notManaged || busy || (AUH_BACKUP_READY ? "" : "Set a backup destination in Settings > App Update Helper first"));
    }

    if (app && app.managed) {
        html += `<button type="button" class="auh-restore" data-container="${escapeHtml(name)}"${active || !AUH_BACKUP_READY ? ' disabled' : ''}>Restore</button>`;
    }

    if (job) {
        let logLink = `<a href="#" class="auh-view-log" data-job="${escapeHtml(job.id)}">View log</a>`;
        if (job.status === 'queued') {
            html += `<span class="auh-job">Queued · ${logLink}</span>`;
        } else if (job.status === 'running') {
            html += `<span class="auh-job"><span class="plugin-spinner"></span> Running · ${logLink}</span>`;
        } else if (job.status === 'done') {
            // Successful jobs are only shown for an hour after they finished; failures stay.
            if (Date.now() / 1000 - job.finished < AUH_DONE_VISIBLE_SECONDS) {
                html += `<span class="auh-job auh-job-done">&#10003; ${jobLabel(job)} done · ${logLink}</span>`;
            }
        } else {
            html += `<span class="auh-job auh-job-failed has-tooltip" data-tooltip="${escapeHtml(job.message)}">&#10007; ${jobLabel(job)} failed · ${logLink}</span>`;
        }
    }
    return html;
}

function renderAllActions() {
    $("#app-versions-body td.auh-actions").each(function() {
        $(this).html(renderActions($(this).attr('data-container')));
    });
}

function loadTable() {
    $.getJSON("/plugins/app-update-helper/api.php", function(data) {
        let html = "";
        auhApps = {};
        if(!data || data.length === 0) {
            html = "<tr><td colspan='7' style='text-align:center;'>No containers found.</td></tr>";
        } else {
            data.forEach(function(app) {
                auhApps[app.name] = app;
                let statusClass = app.update_type ? "status-" + app.update_type.toLowerCase() : "";
                let releaseLink = app.release_notes ? `<a href="${escapeHtml(app.release_notes)}" target="_blank">View Notes</a>` : "N/A";
                let sameVersion = app.current_version === app.newest_version && app.current_version !== "Unknown";
                let tooltipText =getVersionTooltip(app.current_version, app.newest_version, app.update_type);

                let updateTypeText = app.update_type || '-';
                let updateTypeCell = tooltipText
                    ? `<td class="${statusClass} has-tooltip" data-tooltip="${escapeHtml(tooltipText)}">${updateTypeText}</td>`
                    : `<td class="${statusClass}">${updateTypeText}</td>`;

                html += `<tr>
                    <td class="has-tooltip" data-tooltip="${escapeHtml(app.image)}"><strong>${escapeHtml(app.name)}</strong></td>
                    <td>${formatVersionDisplay(escapeHtml(app.current_version), app.update_type)}</td>
                    <td>${sameVersion ? '&lt;same&gt;' : formatVersionDisplay(escapeHtml(app.newest_version), app.update_type)}</td>
                    ${updateTypeCell}
                    <td>${app.released || ''}</td>
                    <td>${releaseLink}</td>
                    <td class="auh-actions" data-container="${escapeHtml(app.name)}">${renderActions(app.name)}</td>
                </tr>`;
            });
        }
        $("#app-versions-body").html(html);
    }).fail(function(jqXHR, textStatus, errorThrown) {
        console.error("Fetch error: ", textStatus, errorThrown);
        $("#app-versions-body").html("<tr><td colspan='7' style='text-align:center; color:red;'>Failed to fetch version data. Check console for details.</td></tr>");
    });
}

function updateLogTitle() {
    let job = auhJobs.find(j => j.id === auhLogJob);
    if (!job) return;
    let status = {queued: 'queued', running: 'running', done: 'finished', failed: 'failed'}[job.status] || job.status;
    $("#auh-log-title").text(`${jobLabel(job)} of ${job.container} (${status})`);
    $("#auh-log-hint").toggle(isJobActive(job));
}

function openLog(jobId) {
    auhLogJob = jobId;
    auhLogOffset = 0;
    $("#auh-log-content").text("");
    updateLogTitle();
    $("#auh-log-overlay").show();
    pollStatus();
}

function closeLog() {
    auhLogJob = null;
    $("#auh-log-overlay").hide();
}

function pollStatus() {
    clearTimeout(auhPollTimer);
    if (auhPollXhr) {
        auhPollXhr.abort();
    }
    let params = {action: 'status'};
    if (auhLogJob) {
        params.job = auhLogJob;
        params.offset = auhLogOffset;
    }

    auhPollXhr = $.getJSON(AUH_JOBS_URL, params);
    auhPollXhr.done(function(response) {
        auhPollXhr = null;
        auhJobs = response.jobs || [];

        // Only append log output for the job and offset this request asked for;
        // anything else is stale (the modal was reopened or switched meanwhile).
        if (response.log && response.log.job === auhLogJob && params.job === auhLogJob && params.offset === auhLogOffset) {
            let pre = $("#auh-log-content");
            if (response.log.content) {
                // Drop the queue placeholder once real output arrives.
                pre.text((auhLogOffset === 0 ? "" : pre.text()) + response.log.content);
                pre.scrollTop(pre[0].scrollHeight);
            } else if (auhLogOffset === 0) {
                pre.text("Waiting in queue...\n");
            }
            auhLogOffset = response.log.offset;
        }
        updateLogTitle();
        renderAllActions();

        // Reload versions whenever a job finishes so updated rows show their new state.
        let finished = auhJobs.filter(j => !isJobActive(j)).map(j => j.id);
        if (auhFinishedIds !== null && finished.some(id => !auhFinishedIds.has(id))) {
            loadTable();
        }
        auhFinishedIds = new Set(finished);

        if (auhJobs.some(isJobActive)) {
            auhPollTimer = setTimeout(pollStatus, 1000);
        }
    }).fail(function(jqXHR, textStatus) {
        if (textStatus === 'abort') {
            return; // superseded by a newer pollStatus() call
        }
        auhPollXhr = null;
        auhPollTimer = setTimeout(pollStatus, 3000);
    });
}

function chooseBackup(name) {
    $.getJSON(AUH_JOBS_URL, {action: 'backups', container: name})
        .done(function(response) {
            let backups = response.backups || [];
            if (backups.length === 0) {
                swal({title: "No backups", text: `No backups found for ${escapeHtml(name)}.`, type: "info", html: true});
                return;
            }
            let options = backups.map(function(b) {
                let date = new Date(b.mtime * 1000).toLocaleString();
                let image = b.digest ? "" : " (appdata only)";
                let size = (b.size / 1048576).toFixed(1);
                return `<option value="${escapeHtml(b.archive)}">${escapeHtml(date)} · ${escapeHtml(b.version || 'unknown version')} · ${size} MiB${image}</option>`;
            }).join("");
            // The dialog may already be closed when the callback runs, so track the choice here.
            let selected = backups[0].archive;
            $(document).off('change.auhrestore').on('change.auhrestore', '#auh-restore-archive', function() {
                selected = $(this).val();
            });
            swal({
                title: "Restore backup?",
                text: `<b>${escapeHtml(name)}</b><br><br><select id="auh-restore-archive">${options}</select>` +
                    "<br><br>Appdata is replaced by the backup (the current folders are kept with a .pre-restore suffix) " +
                    "and the container is recreated with the image it ran back then. The update will show as available again." +
                    "<br><br>Files that were excluded from the backup (see the exclusions in Settings) are not in the archive, " +
                    "so they will be missing after the restore; find them in the .pre-restore folder.",
                type: "warning",
                html: true,
                showCancelButton: true,
                confirmButtonText: "Restore",
                cancelButtonText: "Cancel"
            }, function(confirmed) {
                if (confirmed) {
                    enqueueJob(name, 'restore', selected);
                }
                $(document).off('change.auhrestore');
            });
        })
        .fail(function() {
            swal({title: "Could not list backups", type: "error"});
        });
}

function enqueueJob(name, mode, archive) {
    $.post(AUH_JOBS_URL, {csrf_token: AUH_CSRF_TOKEN, action: 'enqueue', container: name, mode: mode, archive: archive || ''}, null, 'json')
        .done(function(response) {
            auhJobs.push(response.job);
            renderAllActions();
            openLog(response.job.id);
        })
        .fail(function(jqXHR) {
            let message = (jqXHR.responseJSON && jqXHR.responseJSON.error) || "Request failed";
            swal({title: "Could not start job", text: message, type: "error"});
        });
}

$(function() {
    // Native titles don't show on tap on mobile, so tooltips are shown/hidden
    // via a tap-toggled class instead (hover still works on desktop via CSS).
    $(document).on('click', '.has-tooltip', function(e) {
        e.stopPropagation();
        let wasActive = $(this).hasClass('tooltip-active');
        $('.has-tooltip').removeClass('tooltip-active');
        if (!wasActive) {
            $(this).addClass('tooltip-active');
        }
    });
    $(document).on('click', function() {
        $('.has-tooltip').removeClass('tooltip-active');
    });

    $(document).on('click', '.auh-action', function(e) {
        e.stopPropagation();
        // attr() rather than data(): jQuery would coerce numeric-looking names to numbers
        let name = $(this).attr('data-container');
        let mode = $(this).attr('data-mode');
        let app = auhApps[name];
        if (!app) return;

        let backup = mode === 'backup_update';
        let text = `<b>${escapeHtml(name)}</b><br>${escapeHtml(app.current_version)} &rarr; ${escapeHtml(app.newest_version)} (${escapeHtml(app.update_type)})`;
        if (backup) {
            text += "<br><br>The container's appdata will be backed up first. The update is skipped if the backup fails.";
        }
        swal({
            title: backup ? "Backup & update container?" : "Update container?",
            text: text,
            type: "warning",
            html: true,
            showCancelButton: true,
            confirmButtonText: backup ? "Backup & Update" : "Update",
            cancelButtonText: "Cancel"
        }, function(confirmed) {
            if (confirmed) {
                enqueueJob(name, mode);
            }
        });
    });

    $(document).on('click', '.auh-restore', function(e) {
        e.stopPropagation();
        chooseBackup($(this).attr('data-container'));
    });

    $(document).on('click', '.auh-view-log', function(e) {
        e.preventDefault();
        e.stopPropagation();
        openLog($(this).attr('data-job'));
    });
    $("#auh-log-close").on('click', closeLog);
    $("#auh-log-overlay").on('click', function(e) {
        if (e.target === this) closeLog();
    });

    loadTable();
    pollStatus(); // re-attaches to jobs still queued/running from a previous visit
});
</script>
